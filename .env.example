# Application Environment
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://voice.resort.example.com

# Security & Secrets (Must be 32+ characters in production; default fallback forbidden in production)
SECRET_KEY=replace-with-a-very-long-and-secure-random-32char-secret
HMAC_ALGORITHM=HS256
WEBHOOK_SIGNATURE_VERIFY=true

# Allowed CORS Origins (comma-separated origins or JSON array; wildcard '*' disables credentials)
ALLOWED_ORIGINS=https://ai-resort-voice-agent.vercel.app,http://localhost:5173,http://localhost:8000

# Twilio Telephony Credentials
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+18085551234

# Exotel Telephony Credentials
EXOTEL_API_KEY=your_exotel_api_key_here
EXOTEL_API_TOKEN=your_exotel_api_token_here
EXOTEL_ACCOUNT_SID=your_exotel_account_sid_here
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=
EXOTEL_PUBLIC_WSS_URL=

# PostgreSQL Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resort_voice
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/resort_voice
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=resort_voice

# Active AI Providers
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
STT_PROVIDER=assemblyai
STT_MODEL=universal-streaming
TTS_PROVIDER=elevenlabs
TTS_MODEL=eleven_flash_v2_5
TTS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# External API Keys (Leave blank or fill with your provider credentials)
ASSEMBLYAI_API_KEY=...
OPENAI_API_KEY=sk-...
DEEPGRAM_API_KEY=...
ELEVENLABS_API_KEY=...
GEMINI_API_KEY=...
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=eastus

# Email Service
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=SG....
EMAIL_FROM=reservations@azureparadise-resort.com

# Audio & Interruption Engine
RMS_ENERGY_THRESHOLD=450.0
VAD_INTERRUPTION_FRAMES=3
SILENCE_ENDPOINTING_MS=600

# RAG Configuration
VECTOR_DB_TYPE=chroma
RAG_TOP_K=3
SPECULATIVE_PREFETCH_TTL_SECONDS=15
